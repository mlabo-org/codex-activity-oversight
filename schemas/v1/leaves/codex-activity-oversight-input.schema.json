{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-activity-oversight/codex-activity-oversight-input/v1",
  "title": "Codex Activity Oversight state-control input",
  "description": "A coding objective selected explicitly or by Native Codex for durable state control, bound to an exact Codex root thread and deterministic .CAO state transition.",
  "type": "object",
  "required": [
    "activation",
    "objective",
    "workspaceRoot",
    "rootThreadId",
    "stateTransition"
  ],
  "properties": {
    "activation": {
      "type": "string",
      "description": "The activation reason: an explicit current-user selection, continuation of an active CAO workflow, or Native Codex selection because durable state materially helps the task.",
      "enum": [
        "explicit-cao-prefix",
        "explicit-dollar-skill",
        "explicit-bundled-skill",
        "explicit-plugin-workflow",
        "active-workflow-continuation",
        "agent-selected-state-control"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "rootThreadId": {
      "type": "string",
      "description": "The exact current Codex root thread identifier used to isolate state and descendant events from unrelated sessions.",
      "minLength": 1
    },
    "stateTransition": {
      "type": "string",
      "enum": [
        "continue-related",
        "initialize-unrelated"
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "requestedScope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
